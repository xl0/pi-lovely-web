{
	"name": "@xl0/pi-lovely-web",
	"version": "0.3.1",
	"description": "Pi extension package for direct HTTP GET plus web_search, web_fetch, and web_image via Firecrawl, Exa, Tavily, and Brave.",
	"keywords": [
		"pi-package",
		"firecrawl",
		"exa",
		"tavily",
		"brave search",
		"web search",
		"web fetch"
	],
	"type": "module",
	"license": "MIT",
	"homepage": "https://github.com/xl0/pi-lovely-web#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xl0/pi-lovely-web.git"
	},
	"files": [
		"extensions/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"check": "bun run typecheck && bun run biome:check",
		"prepublishOnly": "bun run check",
		"test": "bun run test/run.ts",
		"test:get": "bun run test/get.ts",
		"test:image": "bun run test/image.ts",
		"test:smart": "bun run test/smart-prompt.ts",
		"test:update": "bun run test/update-references.ts",
		"release": "bun run scripts/release.ts",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"biome:check": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@earendil-works/pi-ai": "^0.84.0",
		"@earendil-works/pi-coding-agent": "^0.84.0",
		"@earendil-works/pi-tui": "^0.84.0",
		"@typescript/native-preview": "^7.0.0-dev.20260502.1",
		"bun-types": "^1.3.13",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@xl0/pi-lovely-config": "^0.1.1"
	},

	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.84.0",
		"@earendil-works/pi-coding-agent": ">=0.84.0",
		"@earendil-works/pi-tui": ">=0.84.0",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/xl0/pi-lovely-web/master/assets/web_image.png"
	}
}
